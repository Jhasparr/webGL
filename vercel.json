{
  "version": 2,
  "buildCommand": "npm run frontend:build",
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/main.css",
      "dest": "/main.css"
    },
    {
      "src": "/main.js",
      "dest": "/main.js"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/fonts/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|gif|svg|webp|woff2?|ico))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app.js"
    }
  ]
}