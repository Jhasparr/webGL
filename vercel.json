{
  "version": 2,
  "buildCommand": "npm run frontend:build",
  "routes": [
    {
      "src": "/main.css",
      "dest": "/public/main.css"
    },
    {
      "src": "/main.js",
      "dest": "/public/main.js"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "/(.*\\.(png|jpg|gif|svg|webp|woff2?|ico))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/app.js"
    }
  ]
}